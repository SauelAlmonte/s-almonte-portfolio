# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# cursor — local rules, not for repo
.cursor/

# IDE's
.vscode/
.idea/

# Claude Code — local agent dir (skills, settings, memory), not for repo
/.claude/

# Local agent / tooling memory & scratch
/.remember/

# Local AI/editor guidance docs — not for repo
/AGENTS.md
/CLAUDE.md
/CURSOR.md
/DESIGN-TOKENS.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — local secrets never committed (catch-all: every .env variant)
.env
.env.*
# (re-allow a committed template only if you ever add one)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright — test outputs & browser cache, not for repo
/.playwright/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.playwright-mcp/

# secrets / keys — never commit
*.key
*.p12
*.pfx
service-account*.json
gha-creds-*.json

# graphify — generated knowledge graph output, not for repo
/graphify-out/

# local reference docs (external, regenerable — not committed)
/reference/
