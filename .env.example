# Copy to `.env.local` and fill values. Never commit real secrets.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- NextAuth / Auth.js (v5) ---
# Production: AUTH_URL=https://your-domain.vercel.app (exact site URL — must match OAuth redirect URIs).
# Local dev:
# - Prefer localhost (see below).
# - If `.env.local` still has prod AUTH_URL after `vercel env pull`, the app resets it in development
#   unless you set AUTH_FORCE_PRODUCTION_ORIGIN_DEV=1 (e.g. ngrok).
AUTH_URL=http://localhost:3000
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Legacy names some tools still emit:
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=same-as-AUTH_SECRET

# AUTH_FORCE_PRODUCTION_ORIGIN_DEV=1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=

# MongoDB + email
MONGODB_URI=
RESEND_API_KEY=
CONTACT_EMAIL=
